                    "type": "string"
                  },
                  "DeviceTag": {
                    "type": "string"
                  },
                  "FileMode": {
                    "type": "string"
                  }
                },
                "resources": [
                  {
                    "condition": "[equals(toLower(parameters('type')), toLower('Microsoft.Compute/virtualMachines'))]",
                    "apiVersion": "2024-04-05",
                    "type": "Microsoft.Compute/virtualMachines/providers/guestConfigurationAssignments",
                    "name": "[concat(parameters('vmName'), '/Microsoft.GuestConfiguration/', parameters('assignmentName'))]",
                    "location": "[parameters('location')]",
                    "properties": {
                      "guestConfiguration": {
                        "name": "devicetagginglinux",
                        "contentType": "Custom",
                        "contentUri": "https://github.com/seanstark/defenderforservers-tools/raw/refs/heads/main/machineConfiguration/devicetagging-linux/output/devicetagginglinux.zip",
                        "contentHash": "1E6FBF2069A333FAB909E480E5060FCE7ED2BF57474C401467FDAF59DA7BF578",
                        "assignmentType": "ApplyAndAutoCorrect",
                        "configurationParameter": [
                          {
